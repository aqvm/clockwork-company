[sub_resource type="Resource" id="Resource_undertaker_last_word"]
script = ExtResource("2_effect")
display_name = "Undertaker Last Word"
tooltip_text = "Undertaker Last Word is a triggered effect. When Death happens and Always passes, it applies Damage Killer to Killer."
tags = Array[Resource]([ExtResource("tag_death"), ExtResource("tag_backlash")])
trigger = "Death"
target_selector = "Killer"
effect_type = "Damage Killer"
amount = 3

[resource]
script = ExtResource("1_item")
display_name = "Undertaker Waistcoat"
tooltip_text = "Undertaker Waistcoat is a Armor item with HP +5, armor +1 and one or more triggered effects. Use it to compare what changes immediately and what only appears during combat."
tags = Array[Resource]([ExtResource("tag_armor"), ExtResource("tag_death_backlash"), ExtResource("tag_formal")])
slot = "Armor"
max_hp_modifier = 5
armor_modifier = 1
effects = [SubResource("Resource_undertaker_last_word")]
