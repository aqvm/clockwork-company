[sub_resource type="Resource" id="Resource_rainbarrel_slosh"]
resource_name = "Rainbarrel Slosh"
script = ExtResource("2_effect")
display_name = "Rainbarrel Slosh"
tooltip_text = "Rainbarrel Slosh is a triggered effect. When Battle Start happens and Always passes, it applies an effect to Self."
