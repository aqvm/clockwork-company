[gd_resource type="Resource" script_class="ItemDefinition" load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/data/item_definition.gd" id="1_item"]
[ext_resource type="Script" path="res://scripts/data/effect_definition.gd" id="2_effect"]

[ext_resource type="Resource" path="res://resources/tags/armor.tres" id="tag_armor"]
[ext_resource type="Resource" path="res://resources/tags/battle_start.tres" id="tag_battle_start"]
[ext_resource type="Resource" path="res://resources/tags/guard.tres" id="tag_guard"]
