[sub_resource type="Resource" id="Resource_mirror_mace_glare"]
script = ExtResource("2_effect")
display_name = "Mirror Mace Glare"
tooltip_text = "Mirror Mace Glare is a triggered effect. When Attack happens and Target Has Tag passes, it applies Bonus Damage to Attack Target."
tags = Array[Resource]([ExtResource("tag_fragile")])
trigger = "Attack"
condition = "Target Has Tag"
target_selector = "Attack Target"
effect_type = "Bonus Damage"
amount = 2

[resource]
script = ExtResource("1_item")
display_name = "Mirror Mace"
tooltip_text = "Mirror Mace is a Weapon item with HP -1, physical damage +2 and one or more triggered effects. Use it to compare what changes immediately and what only appears during combat."
tags = Array[Resource]([ExtResource("tag_weapon"), ExtResource("tag_mace"), ExtResource("tag_anti_fragile")])
slot = "Weapon"
max_hp_modifier = -1
physical_damage_modifier = 2
effects = [SubResource("Resource_mirror_mace_glare")]
