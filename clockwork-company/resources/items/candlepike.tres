[sub_resource type="Resource" id="Resource_candlepike_wick"]
script = ExtResource("2_effect")
display_name = "Candlepike Wick"
tooltip_text = "Candlepike Wick is a triggered effect. When Kill happens and Always passes, it applies Heal Self to Self."
tags = Array[Resource]([ExtResource("tag_heal"), ExtResource("tag_kill")])
trigger = "Kill"
target_selector = "Self"
effect_type = "Heal Self"
amount = 3

[resource]
script = ExtResource("1_item")
display_name = "Candlepike"
tooltip_text = "Candlepike is a Weapon item with physical damage +3, speed -1 and one or more triggered effects. Use it to compare what changes immediately and what only appears during combat."
tags = Array[Resource]([ExtResource("tag_weapon"), ExtResource("tag_spear"), ExtResource("tag_sustain")])
slot = "Weapon"
physical_damage_modifier = 3
action_speed_modifier = -1
effects = [SubResource("Resource_candlepike_wick")]
