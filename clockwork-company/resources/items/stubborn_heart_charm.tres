[sub_resource type="Resource" id="Resource_stubborn_heart"]
script = ExtResource("2_effect")
display_name = "Stubborn Heart"
tooltip_text = "Stubborn Heart is a triggered effect. When HP Below Threshold happens and Self HP Below Percent passes, it applies Increase Max HP to Self."
tags = Array[Resource]([ExtResource("tag_survival"), ExtResource("tag_low_hp")])
trigger = "HP Below Threshold"
condition = "Self HP Below Percent"
target_selector = "Self"
effect_type = "Increase Max HP"
amount = 6
threshold_percent = 50
once_per_battle = true

[resource]
script = ExtResource("1_item")
display_name = "Stubborn Heart Charm"
tooltip_text = "Stubborn Heart Charm is a Trinket item with no direct stat change and one or more triggered effects. Use it to compare what changes immediately and what only appears during combat."
tags = Array[Resource]([ExtResource("tag_trinket"), ExtResource("tag_survival"), ExtResource("tag_example")])
slot = "Trinket"
effects = [SubResource("Resource_stubborn_heart")]
