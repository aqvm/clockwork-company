[sub_resource type="Resource" id="Resource_union_mail_link"]
resource_name = "Union Mail Link"
script = ExtResource("2_effect")
display_name = "Union Mail Link"
tooltip_text = "Union Mail Link is a triggered effect. When Battle Start happens and Always passes, it applies an effect to Self."
tags = Array[Resource]([ExtResource("tag_armor"), ExtResource("tag_battle_start")])
amount = 2

[resource]
script = ExtResource("1_item")
display_name = "Union Mail"
tooltip_text = "Union Mail is a Armor item with HP +6, armor +2, speed -2 and one or more triggered effects. Use it to compare what changes immediately and what only appears during combat."
tags = Array[Resource]([ExtResource("tag_armor"), ExtResource("tag_union"), ExtResource("tag_armored")])
slot = "Armor"
max_hp_modifier = 6
armor_modifier = 2
action_speed_modifier = -2
effects = Array[ExtResource("2_effect")]([SubResource("Resource_union_mail_link")])
