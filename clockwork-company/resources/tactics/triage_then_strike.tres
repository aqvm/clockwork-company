[resource]
script = ExtResource("1_tactic")
display_name = "Triage Then Strike"
tooltip_text = "Triage Then Strike is an ordered AI rule: when Ally HP Below Half is valid, use Heal on Lowest HP Ally. Earlier tactics get first chance to act."
tags = Array[Resource]([ExtResource("tag_heal"), ExtResource("tag_priority")])
condition = "Ally HP Below Half"
action = "Heal"
target = "Lowest HP Ally"
