[gd_resource type="Resource" script_class="ScenarioDefinition" format=3]

[ext_resource type="Script" path="res://scripts/data/scenario_definition.gd" id="1_scenario"]
[ext_resource type="Resource" path="res://resources/encounters/fever_choir_rehearsal.tres" id="2_encounter"]
[ext_resource type="Resource" path="res://resources/tags/chapel.tres" id="tag_chapel"]
[ext_resource type="Resource" path="res://resources/tags/fire.tres" id="tag_fire"]
