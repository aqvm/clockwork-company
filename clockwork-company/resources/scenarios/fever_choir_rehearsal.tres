[resource]
script = ExtResource("1_scenario")
scenario_id = "fever_choir_rehearsal"
display_name = "Fever Choir Rehearsal"
description = "A combat-lab-friendly scenario against a synergistic chapel cell built around Burning, Frost, corrupt healing, and tempo support."
story_intro = "The ruined vestry is warm before the doors open. Four voices rehearse a hymn that sounds less like music than a fever learning to count."
story_outro = "The last bell-note dies in the rafters. Whatever they were rehearsing will not be performed tonight."
party_size = 4
encounters = [ExtResource("2_encounter")]
tier = 2
recommended_level_min = 2
recommended_level_max = 3
tags = Array[Resource]([ExtResource("tag_chapel"), ExtResource("tag_fire"), ExtResource("tag_control")])
rewards = []
content_unlocks = ["fever_choir_silenced"]
