[gd_resource type="Resource" script_class="ReactionDefinition" format=3]

[ext_resource type="Script" path="res://scripts/data/reaction_definition.gd" id="1_reaction"]
[ext_resource type="Script" path="res://scripts/data/effect_definition.gd" id="2_effect"]
[ext_resource type="Script" path="res://scripts/data/status_definition.gd" id="3_status"]
[ext_resource type="Resource" path="res://resources/job_features/Pyromancer/double_source_burning.tres" id="4_double_burning"]
[ext_resource type="Resource" path="res://resources/statuses/ward.tres" id="5_ward"]
[ext_resource type="Resource" path="res://resources/statuses/renewal.tres" id="6_renewal"]
[ext_resource type="Resource" path="res://resources/statuses/regeneration.tres" id="7_regeneration"]
[ext_resource type="Resource" path="res://resources/statuses/reconstitution.tres" id="8_reconstitution"]
[ext_resource type="Resource" path="res://resources/tags/burn.tres" id="tag_burn"]
[ext_resource type="Resource" path="res://resources/tags/reaction.tres" id="tag_reaction"]

[resource]
resource_name = "Ember Reversal"
script = ExtResource("1_reaction")
display_name = "Ember Reversal"
tooltip_text = "Ember Reversal is a reaction that can fire on Status Application Requested. It checks Requested Status Is Ailment before resolving effects only."
tags = Array[Resource]([ExtResource("tag_burn"), ExtResource("tag_reaction")])
trigger = "Status Application Requested"
condition = "Requested Status Is Ailment"
reaction_type = "Effects Only"
prevents_triggering_request = true
replacement_statuses = Array[ExtResource("3_status")]([ExtResource("5_ward"), ExtResource("6_renewal"), ExtResource("7_regeneration"), ExtResource("8_reconstitution")])
cooldown_turns = 3
effects = Array[ExtResource("2_effect")]([ExtResource("4_double_burning")])
