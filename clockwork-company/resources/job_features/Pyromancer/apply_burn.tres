[gd_resource type="Resource" script_class="SkillDefinition" format=3]

[ext_resource type="Script" path="res://scripts/data/skill_definition.gd" id="1_skill"]
[ext_resource type="Resource" path="res://resources/statuses/burning.tres" id="2_burning"]
[ext_resource type="Resource" path="res://resources/tags/burn.tres" id="tag_burn"]
[ext_resource type="Resource" path="res://resources/tags/status.tres" id="tag_status"]

[resource]
resource_name = "Apply Burn"
script = ExtResource("1_skill")
display_name = "Apply Burn"
tooltip_text = "Apply Burn applies ExtResource(\"2_burning\") through an active skill. Its main value comes from setting up status-driven tactics and reactions."
tags = Array[Resource]([ExtResource("tag_burn"), ExtResource("tag_status")])
action = "Apply Status"
attack_damage_type = "Magic"
status = ExtResource("2_burning")
