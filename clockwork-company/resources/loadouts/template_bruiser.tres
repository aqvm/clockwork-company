[gd_resource type="Resource" script_class="UnitLoadoutDefinition" format=3]

[ext_resource type="Script" path="res://scripts/data/unit_loadout_definition.gd" id="loadout_script"]
[ext_resource type="Resource" path="res://resources/jobs/bruiser.tres" id="job"]
[ext_resource type="Resource" path="res://resources/tactics/template_bruiser_tactic_1_body_blow_the_slow.tres" id="tactic_1"]
[ext_resource type="Resource" path="res://resources/tactics/template_bruiser_tactic_2_shoulder_check_the_front.tres" id="tactic_2"]

[resource]
script = ExtResource("loadout_script")
display_name = "Template Bruiser"
tooltip_text = "Clean-slate template loadout for testing the Bruiser job with explicit primary and bridge tactics."
current_job = ExtResource("job")
tactics = [ExtResource("tactic_1"), ExtResource("tactic_2")]
