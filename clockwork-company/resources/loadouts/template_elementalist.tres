[gd_resource type="Resource" script_class="UnitLoadoutDefinition" format=3]

[ext_resource type="Script" path="res://scripts/data/unit_loadout_definition.gd" id="loadout_script"]
[ext_resource type="Resource" path="res://resources/jobs/elementalist.tres" id="job"]
[ext_resource type="Resource" path="res://resources/tactics/template_elementalist_tactic_1_fuse_the_loaded_elements.tres" id="tactic_1"]
[ext_resource type="Resource" path="res://resources/tactics/template_elementalist_tactic_2_spark_the_triad.tres" id="tactic_2"]

[resource]
script = ExtResource("loadout_script")
display_name = "Template Elementalist"
tooltip_text = "Clean-slate template loadout for testing the Elementalist job with explicit primary and bridge tactics."
current_job = ExtResource("job")
tactics = [ExtResource("tactic_1"), ExtResource("tactic_2")]
