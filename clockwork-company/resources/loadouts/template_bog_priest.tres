[gd_resource type="Resource" script_class="UnitLoadoutDefinition" format=3]

[ext_resource type="Script" path="res://scripts/data/unit_loadout_definition.gd" id="loadout_script"]
[ext_resource type="Resource" path="res://resources/jobs/bog_priest.tres" id="job"]
[ext_resource type="Resource" path="res://resources/tactics/template_bog_priest_tactic_1_drain_existing_rot.tres" id="tactic_1"]
[ext_resource type="Resource" path="res://resources/tactics/template_bog_priest_tactic_2_bog_mend_the_hurt.tres" id="tactic_2"]
[ext_resource type="Resource" path="res://resources/tactics/template_bog_priest_tactic_3_overwater_the_roots.tres" id="tactic_3"]

[resource]
script = ExtResource("loadout_script")
display_name = "Template Bog Priest"
tooltip_text = "Clean-slate template loadout for testing the Bog Priest job with explicit primary and bridge tactics."
current_job = ExtResource("job")
tactics = [ExtResource("tactic_1"), ExtResource("tactic_2"), ExtResource("tactic_3")]
