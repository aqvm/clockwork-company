[gd_resource type="Resource" script_class="UnitLoadoutDefinition" format=3]

[ext_resource type="Script" path="res://scripts/data/unit_loadout_definition.gd" id="loadout_script"]
[ext_resource type="Resource" path="res://resources/jobs/aegiswright.tres" id="job"]
[ext_resource type="Resource" path="res://resources/tactics/template_aegiswright_tactic_1_share_the_reserve.tres" id="tactic_1"]
[ext_resource type="Resource" path="res://resources/tactics/template_aegiswright_tactic_2_pierce_with_aegis.tres" id="tactic_2"]

[resource]
script = ExtResource("loadout_script")
display_name = "Template Aegiswright"
tooltip_text = "Clean-slate template loadout for testing the Aegiswright job with explicit primary and bridge tactics."
current_job = ExtResource("job")
tactics = [ExtResource("tactic_1"), ExtResource("tactic_2")]
