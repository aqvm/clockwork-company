[gd_resource type="Resource" script_class="UnitLoadoutDefinition" format=3]

[ext_resource type="Script" path="res://scripts/data/unit_loadout_definition.gd" id="loadout_script"]
[ext_resource type="Resource" path="res://resources/jobs/paladin.tres" id="job"]
[ext_resource type="Resource" path="res://resources/tactics/template_paladin_tactic_1_raise_the_spiritual_barrier.tres" id="tactic_1"]
