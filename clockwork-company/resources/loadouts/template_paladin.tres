[resource]
script = ExtResource("loadout_script")
display_name = "Template Paladin"
tooltip_text = "Clean-slate template loadout for testing the Paladin job with explicit primary and bridge tactics."
current_job = ExtResource("job")
tactics = [ExtResource("tactic_1"), ExtResource("tactic_2")]
