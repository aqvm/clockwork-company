[sub_resource type="Resource" id="Resource_foundry_monk_default_tactic"]
script = ExtResource("5_tactic")
display_name = "Bank the Furnace"
tooltip_text = "Bank the Furnace is an ordered AI rule: when Enemy Alive is valid, use Job Skill on Self. Earlier tactics get first chance to act."
tags = Array[Resource]([ExtResource("tag_job_default")])
condition = "Enemy Alive"
action = "Job Skill"
target = "Self"

[sub_resource type="Resource" id="Resource_foundry_monk_passive"]
resource_name = "Tempered Breath"
script = ExtResource("3_passive")
display_name = "Tempered Breath"
tooltip_text = "Tempered Breath is a passive rule that stays available while equipped. It provides a guard armor bonus and may add nested effects or cooldown timing."
tags = Array[Resource]([ExtResource("tag_guard")])
passive_type = "Guard Armor Bonus"
amount = 1
cooldown_turns = 1

[sub_resource type="Resource" id="Resource_foundry_monk_reaction"]
resource_name = "Turtle Furnace"
script = ExtResource("4_reaction")
display_name = "Turtle Furnace"
tooltip_text = "Turtle Furnace is a reaction that can fire on HP Below Threshold. It checks Self HP Below Percent before resolving its reaction effect."
tags = Array[Resource]([ExtResource("tag_low_hp"), ExtResource("tag_reaction")])
trigger = "HP Below Threshold"
condition = "Self HP Below Percent"
amount = 8
threshold_percent = 35
cooldown_turns = 6

[sub_resource type="Resource" id="Resource_foundry_monk_skill"]
resource_name = "Bank the Furnace"
script = ExtResource("2_skill")
display_name = "Bank the Furnace"
tooltip_text = "Bank the Furnace is a guard skill. It spends the action on protection instead of damage and can be improved by guard bonuses or attached effects."
tags = Array[Resource]([ExtResource("tag_foundry"), ExtResource("tag_guard")])
action = "Guard"
default_target = "Self"
amount_modifier = 2

[resource]
script = ExtResource("1_job")
display_name = "Foundry Monk"
tooltip_text = "Foundry Monk is a job path with HP +2, armor +1 per level. Its skill, passive, reaction, and default tactic define the role this unit is learning into."
tags = Array[Resource]([ExtResource("tag_job"), ExtResource("tag_foundry"), ExtResource("tag_guard")])
max_hp_growth = 2
armor_growth = 1
skill = SubResource("Resource_foundry_monk_skill")
passive = SubResource("Resource_foundry_monk_passive")
reaction = SubResource("Resource_foundry_monk_reaction")
default_tactic = SubResource("Resource_foundry_monk_default_tactic")
