[gd_resource type="Resource" script_class="JobDefinition" format=3]

[ext_resource type="Script" path="res://scripts/data/job_definition.gd" id="job_script"]
[ext_resource type="Script" path="res://scripts/data/skill_definition.gd" id="skill_script"]
[ext_resource type="Script" path="res://scripts/data/passive_definition.gd" id="passive_script"]
[ext_resource type="Script" path="res://scripts/data/reaction_definition.gd" id="reaction_script"]
[ext_resource type="Script" path="res://scripts/data/tactic_definition.gd" id="tactic_script"]
[ext_resource type="Script" path="res://scripts/data/effect_definition.gd" id="effect_script"]

[sub_resource type="Resource" id="Bruiser_Delay"]
script = ExtResource("effect_script")
display_name = "Delay Target"
tooltip_text = "Authored effect for this job feature."
trigger = "Skill Completed"
target_selector = "Event Target"
effect_type = "Delay Action"
amount = 4

[sub_resource type="Resource" id="Bruiser_Current_HP_Hit"]
script = ExtResource("effect_script")
display_name = "Current-HP Hit"
tooltip_text = "Authored effect for this job feature."
trigger = "Skill Used"
target_selector = "Event Target"
effect_type = "Deal Damage"
amount_source = "Target Current HP"
amount_rounding = "Ceil"
amount_multiplier = 25
amount_divisor = 100
damage_type = "Physical"

[sub_resource type="Resource" id="Bruiser_Haste_On_Physical"]
script = ExtResource("effect_script")
display_name = "Haste on Physical Damage"
tooltip_text = "Authored effect for this job feature."
trigger = "Physically Damaged"
target_selector = "Self"
effect_type = "Apply Haste"
modifier_duration_turns = 3
amount = 2
repeat_within_event_chain = true

[sub_resource type="Resource" id="Skill_Shoulder_Check"]
script = ExtResource("skill_script")
display_name = "Shoulder Check"
tooltip_text = "Strike twice, then delay the target."
action = "Attack"
attack_count = 2
effects = [SubResource("Bruiser_Delay")]

[sub_resource type="Resource" id="Skill_Body_Blow"]
script = ExtResource("skill_script")
display_name = "Body Blow"
tooltip_text = "Deal physical damage equal to 25% of the target's current HP."
action = "Effects Only"
effects = [SubResource("Bruiser_Current_HP_Hit")]

[sub_resource type="Resource" id="Passive_Pain_Tempo"]
script = ExtResource("passive_script")
display_name = "Pain Tempo"
tooltip_text = "Physical damage temporarily hastens the Bruiser."
passive_type = "None"
effects = [SubResource("Bruiser_Haste_On_Physical")]

[sub_resource type="Resource" id="Reaction_Interpose"]
script = ExtResource("reaction_script")
display_name = "Interpose"
tooltip_text = "Redirect an enemy attack aimed at another ally to the Bruiser."
trigger = "Attack Targets Another Ally"
condition = "Always"
reaction_type = "Effects Only"
cooldown_turns = 4

[sub_resource type="Resource" id="Tactic_Use_Shoulder_Check"]
script = ExtResource("tactic_script")
display_name = "Use Shoulder Check"
tooltip_text = "Use Shoulder Check is this job template default tactic."
condition = "Enemy Alive"
action = "Job Skill"
target = "Frontmost Enemy"

[resource]
script = ExtResource("job_script")
display_name = "Bruiser"
tooltip_text = "Bruiser is a clean-slate authored job Resource based on the current design notes. Growth and abilities are visible for tuning."
max_hp_growth = 4
physical_damage_growth = 1
armor_growth = 1
skill = SubResource("Skill_Shoulder_Check")
secondary_skill = SubResource("Skill_Body_Blow")
passive = SubResource("Passive_Pain_Tempo")
reaction = SubResource("Reaction_Interpose")
default_tactic = SubResource("Tactic_Use_Shoulder_Check")
