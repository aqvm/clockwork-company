[ext_resource type="Resource" path="res://resources/tags/job_default.tres" id="tag_job_default"]
[ext_resource type="Resource" path="res://resources/tags/low_hp.tres" id="tag_low_hp"]
[ext_resource type="Resource" path="res://resources/tags/reaction.tres" id="tag_reaction"]
[ext_resource type="Resource" path="res://resources/tags/skill.tres" id="tag_skill"]

[sub_resource type="Resource" id="Resource_guard_default_tactic"]
script = ExtResource("5_tactic")
display_name = "Raise Shield Wall"
tooltip_text = "Raise Shield Wall is an ordered AI rule: when Enemy Alive is valid, use Job Skill on Self. Earlier tactics get first chance to act."
tags = Array[Resource]([ExtResource("tag_job_default")])
condition = "Enemy Alive"
action = "Job Skill"
target = "Self"

[sub_resource type="Resource" id="Resource_guard_passive"]
resource_name = "Guard Training"
script = ExtResource("3_passive")
display_name = "Guard Training"
tooltip_text = "Guard Training is a passive rule that stays available while equipped. It provides a guard armor bonus and may add nested effects or cooldown timing."
tags = Array[Resource]([ExtResource("tag_guard")])
passive_type = "Guard Armor Bonus"
amount = 1

[sub_resource type="Resource" id="Resource_guard_reaction"]
resource_name = "Hold Fast"
script = ExtResource("4_reaction")
display_name = "Hold Fast"
tooltip_text = "Hold Fast is a reaction that can fire on HP Below Threshold. It checks Self HP Below Percent before resolving its reaction effect."
tags = Array[Resource]([ExtResource("tag_low_hp"), ExtResource("tag_reaction")])
trigger = "HP Below Threshold"
condition = "Self HP Below Percent"
amount = 3
cooldown_turns = 4

[sub_resource type="Resource" id="Resource_guard_skill"]
resource_name = "Shield Wall"
script = ExtResource("2_skill")
display_name = "Shield Wall"
tooltip_text = "Shield Wall is a guard skill. It spends the action on protection instead of damage and can be improved by guard bonuses or attached effects."
tags = Array[Resource]([ExtResource("tag_guard"), ExtResource("tag_skill")])
action = "Guard"
default_target = "Self"
amount_modifier = 1

[resource]
script = ExtResource("1_job")
display_name = "Guard"
tooltip_text = "Guard is a job path with HP +2, armor +1 per level. Its skill, passive, reaction, and default tactic define the role this unit is learning into."
max_hp_growth = 2
armor_growth = 1
skill = SubResource("Resource_guard_skill")
passive = SubResource("Resource_guard_passive")
reaction = SubResource("Resource_guard_reaction")
default_tactic = SubResource("Resource_guard_default_tactic")
