[sub_resource type="Resource" id="Resource_red_scribe_skill"]
script = ExtResource("2_skill")
display_name = "Red Stitch"
tooltip_text = "Red Stitch is an active healing skill. Tactics decide who receives it, while amount modifiers and effects decide how much extra help it provides."
tags = Array[Resource]([ExtResource("tag_blood"), ExtResource("tag_heal"), ExtResource("tag_magic")])
action = "Heal"
default_target = "Lowest HP Ally"
amount_modifier = 2

[sub_resource type="Resource" id="Resource_red_scribe_passive"]
script = ExtResource("3_passive")
display_name = "Blood Margin"
tooltip_text = "Blood Margin is a passive rule that stays available while equipped. It provides a heal bonus and may add nested effects or cooldown timing."
tags = Array[Resource]([ExtResource("tag_support")])
passive_type = "Heal Bonus"
amount = 1
cooldown_turns = 1

[sub_resource type="Resource" id="Resource_red_scribe_reaction"]
script = ExtResource("4_reaction")
display_name = "Ink Clot"
tooltip_text = "Ink Clot is a reaction that can fire on HP Below Threshold. It checks Self HP Below Percent before resolving heal self."
tags = Array[Resource]([ExtResource("tag_low_hp"), ExtResource("tag_reaction")])
trigger = "HP Below Threshold"
condition = "Self HP Below Percent"
reaction_type = "Heal Self"
amount = 3
threshold_percent = 50
cooldown_turns = 3

[sub_resource type="Resource" id="Resource_red_scribe_default_tactic"]
script = ExtResource("5_tactic")
display_name = "Write the Wound"
tooltip_text = "Write the Wound is an ordered AI rule: when Ally HP Below Half is valid, use Job Skill on Lowest HP Ally. Earlier tactics get first chance to act."
tags = Array[Resource]([ExtResource("tag_job_default")])
condition = "Ally HP Below Half"
action = "Job Skill"
target = "Lowest HP Ally"

[resource]
script = ExtResource("1_job")
display_name = "Red Scribe"
tooltip_text = "Red Scribe is a job path with magic damage +1, speed +1 per level. Its skill, passive, reaction, and default tactic define the role this unit is learning into."
tags = Array[Resource]([ExtResource("tag_job"), ExtResource("tag_support"), ExtResource("tag_blood")])
max_hp_growth = 0
physical_damage_growth = 0
magic_damage_growth = 1
armor_growth = 0
action_speed_growth = 1
skill = SubResource("Resource_red_scribe_skill")
passive = SubResource("Resource_red_scribe_passive")
reaction = SubResource("Resource_red_scribe_reaction")
default_tactic = SubResource("Resource_red_scribe_default_tactic")
