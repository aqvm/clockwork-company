[sub_resource type="Resource" id="Resource_chirurgeon_default_tactic"]
script = ExtResource("5_tactic")
display_name = "Field Stitch Triage"
tooltip_text = "Field Stitch Triage is an ordered AI rule: when Ally HP Below Half is valid, use Job Skill on Lowest HP Ally. Earlier tactics get first chance to act."
tags = Array[Resource]([ExtResource("tag_job_default")])
condition = "Ally HP Below Half"
action = "Job Skill"
target = "Lowest HP Ally"

[sub_resource type="Resource" id="Resource_chirurgeon_passive"]
resource_name = "Clean Hands"
script = ExtResource("3_passive")
display_name = "Clean Hands"
tooltip_text = "Clean Hands is a passive rule that stays available while equipped. It provides a heal bonus and may add nested effects or cooldown timing."
tags = Array[Resource]([ExtResource("tag_healer")])
passive_type = "Heal Bonus"
amount = 2
cooldown_turns = 1

[sub_resource type="Resource" id="Resource_chirurgeon_reaction"]
resource_name = "Reflex Splint"
script = ExtResource("4_reaction")
display_name = "Reflex Splint"
tooltip_text = "Reflex Splint is a reaction that can fire on HP Below Threshold. It checks Self HP Below Percent before resolving its reaction effect."
tags = Array[Resource]([ExtResource("tag_low_hp"), ExtResource("tag_reaction")])
trigger = "HP Below Threshold"
condition = "Self HP Below Percent"
amount = 3
cooldown_turns = 4

[sub_resource type="Resource" id="Resource_chirurgeon_skill"]
resource_name = "Field Stitch"
script = ExtResource("2_skill")
display_name = "Field Stitch"
tooltip_text = "Field Stitch is an active healing skill. Tactics decide who receives it, while amount modifiers and effects decide how much extra help it provides."
tags = Array[Resource]([ExtResource("tag_healer"), ExtResource("tag_heal"), ExtResource("tag_magic")])
action = "Heal"
default_target = "Lowest HP Ally"
amount_modifier = 2

[resource]
script = ExtResource("1_job")
display_name = "Chirurgeon"
tooltip_text = "Chirurgeon is a job path with HP +1, magic damage +1, armor +1 per level. Its skill, passive, reaction, and default tactic define the role this unit is learning into."
tags = Array[Resource]([ExtResource("tag_job"), ExtResource("tag_healer"), ExtResource("tag_armor")])
max_hp_growth = 1
magic_damage_growth = 1
armor_growth = 1
skill = SubResource("Resource_chirurgeon_skill")
passive = SubResource("Resource_chirurgeon_passive")
reaction = SubResource("Resource_chirurgeon_reaction")
default_tactic = SubResource("Resource_chirurgeon_default_tactic")
